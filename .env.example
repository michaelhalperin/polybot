# Copy this file to ".env" and fill in your values.
#   cp .env.example .env
# Your real .env is gitignored and never committed.
#
# On Render (or any host), set these in the dashboard's Environment settings
# instead — real environment variables always take precedence over .env.

# Anthropic API key — only needed if you enable the AI market-understanding
# layer (strategy.enable_llm_understanding: true in config.yaml).
# Get one at https://platform.claude.com  (account needs billing/credits).
ANTHROPIC_API_KEY=sk-ant-your-key-here
