# Copy to .env and fill in. Real shell env vars always win over this file.

# Optional: AI market understanding
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: protect the local dashboard (off by default even if POLYBOT_PASSWORD is set)
# POLYBOT_REQUIRE_AUTH=1

# Prod remote API password — same value as on Render; used for the Prod toggle only
# POLYBOT_PASSWORD=your-secret

# Live prod view from local dashboard (required to use the Prod toggle)
# POLYBOT_PROD_URL=https://polybot-xxxx.onrender.com   # your Render service URL
# POLYBOT_PASSWORD=...                                   # same as Render dashboard password

# Offline prod snapshot via `python run.py pull` (Render SSH)
# POLYBOT_PROD_SSH=srv-abc123@ssh.render.com
# POLYBOT_PROD_DB_REMOTE=/var/data/polybot.db

# Default dashboard profile when starting: local | prod
# POLYBOT_PROFILE=local
